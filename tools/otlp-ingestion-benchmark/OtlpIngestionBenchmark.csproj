<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TelemetrySourceRoot Condition="'$(TelemetrySourceRoot)' == ''">$(MSBuildThisFileDirectory)../..</TelemetrySourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(TelemetrySourceRoot)/modules/telemetry/Selfrun.Telemetry.csproj" />
  </ItemGroup>
</Project>
