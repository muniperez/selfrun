[Unit]
Description=Pinned loopback-only T3; no invented drain API
After=minicloud-workspace.service
Requires=minicloud-workspace.service
Wants=minicloud-t3-connect.service
ConditionPathIsDirectory=/workspace/t3
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=coding
Group=coding
Slice=minicloudwork.slice
WorkingDirectory=/workspace
Environment=HOME=/workspace/home
Environment=CODEX_HOME=/workspace/home/.codex
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/opt/minicloud-workspace/scratch.env
ExecStartPre=-+/usr/bin/python3 -B /opt/minicloud-workspace/storage_tiers.py prepare
ExecStartPre=-/usr/bin/python3 -B /opt/minicloud-workspace/copilot_provider.py configure --base-dir /workspace/t3
ExecStart=/usr/local/bin/t3 serve --host 127.0.0.1 --port 3773 --base-dir /workspace/t3 --no-browser
Restart=on-failure
RestartSec=5
SuccessExitStatus=130
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/workspace -/var/lib/minicloud-scratch
PrivateTmp=yes
KillMode=process
TimeoutStopSec=30
SendSIGKILL=no
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
