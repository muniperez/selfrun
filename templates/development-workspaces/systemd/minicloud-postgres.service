[Unit]
Description=Workspace-local PostgreSQL 16, data retained only for primary VMs
After=minicloud-workspace.service
Requires=minicloud-workspace.service
ConditionPathExists=/workspace/postgres/16/PG_VERSION

[Service]
Type=simple
User=postgres
Group=postgres
RuntimeDirectory=minicloud-postgres
RuntimeDirectoryMode=0755
ExecStart=/usr/lib/postgresql/16/bin/postgres -D /workspace/postgres/16 -c listen_addresses=127.0.0.1 -c unix_socket_directories=/run/minicloud-postgres
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=120
SendSIGKILL=no
Restart=no
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/workspace/postgres/16 /run/minicloud-postgres
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
