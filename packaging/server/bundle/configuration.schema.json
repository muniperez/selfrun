{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minicloud.invalid/server-configuration.schema.json",
  "title": "Minicloud server public configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiUrl", "consoleUrl", "appDomain", "apiHostname", "consoleHostname"],
  "properties": {
    "apiUrl": { "$ref": "#/$defs/httpsOrigin" },
    "consoleUrl": { "$ref": "#/$defs/httpsOrigin" },
    "appDomain": { "$ref": "#/$defs/hostname" },
    "apiHostname": { "$ref": "#/$defs/hostname" },
    "consoleHostname": { "$ref": "#/$defs/hostname" },
    "manageDnsRecords": { "type": "boolean", "default": false },
    "googleOidc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "credentialsFile": {
          "type": "string",
          "pattern": "^/",
          "description": "Absolute protected operator input path, never a credential value."
        }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "required": ["credentialsFile"] },
      "else": { "not": { "required": ["credentialsFile"] } }
    },
    "portalSessions": {
      "type": "object",
      "additionalProperties": false,
      "description": "Dashboard sign-in session policy. Remembered durations must be at least the standard durations; each maximum must be at least its idle timeout.",
      "properties": {
        "keepSignedInEnabled": { "type": "boolean", "default": true, "description": "Offer the per-user Keep me signed in option." },
        "standardIdleMinutes": { "type": "integer", "minimum": 1, "maximum": 43200, "default": 120 },
        "standardMaxMinutes": { "type": "integer", "minimum": 1, "maximum": 129600, "default": 720 },
        "rememberedIdleMinutes": { "type": "integer", "minimum": 1, "maximum": 43200, "default": 10080 },
        "rememberedMaxMinutes": { "type": "integer", "minimum": 1, "maximum": 129600, "default": 43200 }
      }
    },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://[^/@\\s]+(?:/[^\\s]*)?$" },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openBaoUnsealMaterialPath": { "type": "string", "minLength": 1 },
        "backupDestination": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "httpsOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[a-z0-9.-]+$"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    }
  }
}
